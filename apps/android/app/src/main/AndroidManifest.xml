<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground service (spec §8): hosts the single Vault instance,
         the custom-protocol/internal listener, and the retention cache. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- "Start VaultSigner at login/startup" (spec §8) — the Android
         equivalent of launchd RunAtLoad / a Windows Service autostart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VaultSignerApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.VaultSigner"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VaultSigner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launched via a PendingIntent from either the system Credential
             Manager picker (spec §6.3) or VaultSignerService's own consent
             flow for a `vaultsigner.sign` custom-protocol request (spec
             §7) — the one on-demand, screen-capture-blocked (spec §5.0)
             passphrase surface both flows share, never a second Vault. -->
        <activity
            android:name=".credentialprovider.PassphrasePromptActivity"
            android:process=":agent"
            android:exported="false"
            android:theme="@style/Theme.VaultSigner.Dialog"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- Completes one FIDO2 ceremony (spec §6.3/§6.6): the target of
             the PendingIntent behind every PublicKeyCredentialEntry/
             CreateEntry VaultSignerCredentialProviderService offers. Runs
             in the same ":agent" process so it shares AgentState.vault
             directly. -->
        <activity
            android:name=".credentialprovider.PasskeyCompletionActivity"
            android:process=":agent"
            android:exported="false"
            android:theme="@style/Theme.VaultSigner.Dialog"
            android:excludeFromRecents="true" />

        <!-- Spec §8: owns the single Vault instance and every write to the
             container file. Runs in its own process so it survives the UI
             Activity's process being killed, mirroring launchd/Windows
             Service being a separate process from the management UI. -->
        <service
            android:name=".service.VaultSignerService"
            android:process=":agent"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local FIDO2/passkey and signing-request server for a user-controlled key vault; holds decrypted key material in memory only while unlocked." />
        </service>

        <!-- Autostart (spec §8's "Start VaultSigner at login/startup",
             default on) — starts VaultSignerService after boot, mirroring
             launchd's RunAtLoad / the Windows Service's own autostart. -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FIDO2/WebAuthn OS integration (spec §6.3). Runs in the same
             ":agent" process as VaultSignerService so both hold the exact
             same in-process Vault reference — never a second, independent
             Vault instance (the architectural gap macOS's credential
             provider extension couldn't avoid, since it's a genuinely
             separate OS process there; Android's single-APK, same-process
             model lets this be done correctly from the start). -->
        <service
            android:name=".credentialprovider.VaultSignerCredentialProviderService"
            android:process=":agent"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>

    </application>
</manifest>
