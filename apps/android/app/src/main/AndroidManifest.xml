<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground service (spec §8): hosts the single Vault instance,
         the custom-protocol/internal listener, and the retention cache.
         Declares both foreground-service types VaultSignerService can
         run as (see that class's own doc comment for why): "specialUse"
         on API 34+, "dataSync" as the pre-34 stand-in (per-type runtime
         permissions, this one included, are themselves only enforced
         starting API 34 — declaring both here is harmless on every
         earlier OS version and correct on 34+ regardless of which flavor
         happens to be running there). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- "Start VaultSigner at login/startup" (spec §8) — the Android
         equivalent of launchd RunAtLoad / a Windows Service autostart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VaultSignerApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.VaultSigner"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VaultSigner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launched via a PendingIntent from either the system Credential
             Manager picker (spec §6.3) or VaultSignerService's own consent
             flow for a `vaultsigner.sign` custom-protocol request (spec
             §7) — the one on-demand, screen-capture-blocked (spec §5.0)
             passphrase surface both flows share, never a second Vault. -->
        <activity
            android:name=".credentialprovider.PassphrasePromptActivity"
            android:process=":agent"
            android:exported="false"
            android:theme="@style/Theme.VaultSigner.Dialog"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- Spec §8: owns the single Vault instance and every write to the
             container file. Runs in its own process so it survives the UI
             Activity's process being killed, mirroring launchd/Windows
             Service being a separate process from the management UI.
             Fully shared between flavors — see its own doc comment for
             how it picks a foreground-service type safe for its actual
             minSdk (23 for "lite", 34 for "full") at runtime rather than
             assuming API 34's "specialUse" is always available. -->
        <service
            android:name=".service.VaultSignerService"
            android:process=":agent"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local FIDO2/passkey and signing-request server for a user-controlled key vault; holds decrypted key material in memory only while unlocked." />
        </service>

        <!-- Autostart (spec §8's "Start VaultSigner at login/startup",
             default on) — starts VaultSignerService after boot, mirroring
             launchd's RunAtLoad / the Windows Service's own autostart. -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
