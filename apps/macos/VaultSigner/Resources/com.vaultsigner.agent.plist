<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vaultsigner.agent</string>
    <!-- BundleProgram is relative to this app's own Contents/ directory
         (an SMAppService-specific key, unlike classic launchd's absolute
         Program/ProgramArguments) — see project.yml's postbuild script
         for how VaultSignerAgent.app ends up embedded at this path. -->
    <key>BundleProgram</key>
    <string>Contents/Resources/VaultSignerAgent.app/Contents/MacOS/VaultSignerAgent</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
