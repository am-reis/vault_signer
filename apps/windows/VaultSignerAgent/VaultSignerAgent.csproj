<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VaultSignerAgent</RootNamespace>
    <AssemblyName>VaultSignerAgent</AssemblyName>
    <!-- No visible window at startup (background agent, mirrors macOS's
         LSUIElement accessory-policy app) — WinFormsPassphrasePrompter
         is the only UI this process ever shows, on demand. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by Scripts/generate-csharp-bindings.ps1 from vaultcore's
         UniFFI export surface. Not checked in (see .gitignore) — every
         dev/CI run regenerates it from the exact vaultcore build being
         used, same reasoning as apps/macos not checking in its generated
         vaultcore.swift. -->
    <Compile Include="..\Generated\vaultcore.cs" Condition="Exists('..\Generated\vaultcore.cs')" />
  </ItemGroup>

  <Target Name="CopyVaultcoreNativeLib" AfterTargets="Build">
    <!-- Mirrors apps/macos/Scripts/embed-vaultcore-dylib.sh's role: the
         generated bindings P/Invoke into vaultcore.dll by name, which
         the loader resolves from the executable's own directory. -->
    <ItemGroup>
      <VaultcoreDll Include="..\..\..\target\release\vaultcore.dll" Condition="Exists('..\..\..\target\release\vaultcore.dll')" />
      <VaultcoreDll Include="..\..\..\target\debug\vaultcore.dll" Condition="!Exists('..\..\..\target\release\vaultcore.dll') AND Exists('..\..\..\target\debug\vaultcore.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(VaultcoreDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(VaultcoreDll)' != ''" />
  </Target>

</Project>
