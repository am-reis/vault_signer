<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.BackupMasterKeyOnlyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="440" HorizontalAlignment="Center">

                <HyperlinkButton x:Name="BackButtonElement" Padding="0" Click="BackButton_Click" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="22" />
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Name="WarningText" TextWrapping="Wrap" Opacity="0.85" />

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <PasswordBox x:Name="TransferPasswordBox" />
                <PasswordBox x:Name="ConfirmTransferPasswordBox" />

                <Button x:Name="BackUpButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Click="BackUpButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
