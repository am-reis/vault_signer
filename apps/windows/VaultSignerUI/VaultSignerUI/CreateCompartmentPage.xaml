<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.CreateCompartmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="440" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton x:Name="BackButtonElement" Padding="0" Click="BackButton_Click" />
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <TextBox x:Name="LabelBox" />
                <PasswordBox x:Name="PassphraseBox" />
                <PasswordBox x:Name="ConfirmPassphraseBox" />
                <local:DeviceProfilePicker x:Name="ProfilePicker" />

                <Button x:Name="CreateButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Click="CreateButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
