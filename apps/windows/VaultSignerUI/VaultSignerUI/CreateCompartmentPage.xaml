<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.CreateCompartmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="440" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton Content="&#x2190; Back" Padding="0" Click="BackButton_Click" />
                    <TextBlock Text="New Compartment" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="A compartment is its own independent set of keys with its own master passphrase, inside this same vault file. Use this if you want, for example, a separate 'Work' set of keys from your 'Personal' ones." />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <TextBox x:Name="LabelBox" PlaceholderText="Compartment name, e.g. Work" />
                <PasswordBox x:Name="PassphraseBox" PlaceholderText="Master passphrase for this compartment" />
                <PasswordBox x:Name="ConfirmPassphraseBox" PlaceholderText="Confirm master passphrase" />
                <local:DeviceProfilePicker x:Name="ProfilePicker" />

                <Button x:Name="CreateButton" Content="Create Compartment" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Click="CreateButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
