<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.CreateKeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="480" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton x:Name="BackButtonElement" Padding="0" Click="BackButton_Click" />
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel Spacing="8">
                    <TextBlock x:Name="LabelFieldText" FontWeight="SemiBold" />
                    <TextBox x:Name="LabelBox" />

                    <TextBlock x:Name="DescriptionFieldText" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72" />

                    <TextBlock x:Name="ResourceFieldText" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="ResourceBox" />

                    <TextBlock x:Name="TagsFieldText" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="TagsBox" />

                    <TextBlock x:Name="KeyTypeFieldText" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ComboBox x:Name="KeyTypeCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem x:Name="Ed25519Item" />
                        <ComboBoxItem x:Name="EcdsaP256Item" />
                    </ComboBox>
                    <TextBlock x:Name="Fido2ExplanationText" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />

                    <TextBlock x:Name="PassphraseFieldText" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <PasswordBox x:Name="PassphraseBox" />
                    <PasswordBox x:Name="ConfirmPassphraseBox" />
                </StackPanel>

                <Button x:Name="CreateButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Click="CreateButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
