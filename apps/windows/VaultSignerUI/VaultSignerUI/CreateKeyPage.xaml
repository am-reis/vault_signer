<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.CreateKeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="480" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton Content="&#x2190; Back" Padding="0" Click="BackButton_Click" />
                    <TextBlock Text="New Key" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Label" FontWeight="SemiBold" />
                    <TextBox x:Name="LabelBox" PlaceholderText="e.g. Deploy signing key" />

                    <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="DescriptionBox" PlaceholderText="Optional" AcceptsReturn="True" TextWrapping="Wrap" Height="72" />

                    <TextBlock Text="Resource" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="ResourceBox" PlaceholderText="e.g. a hostname or service name" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Key type" FontWeight="SemiBold" />
                            <ComboBox x:Name="KeyTypeCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Ed25519" />
                                <ComboBoxItem Content="ECDSA P-256" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="Purpose" FontWeight="SemiBold" />
                            <ComboBox x:Name="PurposeCombo" HorizontalAlignment="Stretch" SelectedIndex="1">
                                <ComboBoxItem Content="FIDO2" />
                                <ComboBoxItem Content="Custom signing" />
                                <ComboBoxItem Content="Both" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Key passphrase" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <PasswordBox x:Name="PassphraseBox" PlaceholderText="Required each time this key is used to sign" />
                </StackPanel>

                <Button x:Name="CreateButton" Content="Create Key" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Click="CreateButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
