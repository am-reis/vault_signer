<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VaultSignerUI.DeviceProfilePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <TextBlock x:Name="DeviceProfileLabelText" FontWeight="SemiBold" />
        <RadioButtons x:Name="ProfileRadios" SelectedIndex="0">
            <RadioButton x:Name="DesktopRadio" />
            <RadioButton x:Name="MobileRadio" />
        </RadioButtons>
        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
    </StackPanel>
</UserControl>
