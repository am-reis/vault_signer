<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.ExportKeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="520" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton x:Name="BackButtonElement" Padding="0" Click="BackButton_Click" />
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel x:Name="KeySelectionSection" Spacing="8">
                    <TextBlock x:Name="KeysToIncludeText" FontWeight="SemiBold" />
                    <ListView x:Name="KeysList" SelectionMode="Multiple" MaxHeight="180">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:KeyRow">
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind TypeAndPurpose}" Opacity="0.65" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel x:Name="IncludeMasterKeySection" Spacing="4">
                    <CheckBox x:Name="IncludeMasterKeyCheck" />
                    <TextBlock x:Name="IncludeMasterExplanationText" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                </StackPanel>

                <TextBlock x:Name="ProtectWithText" FontWeight="SemiBold" />

                <StackPanel Spacing="10">
                    <RadioButton x:Name="AsIsRadio" GroupName="Encryption" Checked="EncryptionOption_Checked" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock x:Name="AsIsTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="AsIsDetailText" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DestinationPasswordRadio" GroupName="Encryption" Checked="EncryptionOption_Checked" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock x:Name="DestinationTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DestinationDetailText" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                            <PasswordBox x:Name="DestinationPasswordBox" Visibility="Collapsed" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TransferPasswordRadio" GroupName="Encryption" Checked="EncryptionOption_Checked" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock x:Name="TransferTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TransferDetailText" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                            <StackPanel x:Name="TransferPasswordFields" Visibility="Collapsed" Spacing="6">
                                <PasswordBox x:Name="TransferPasswordBox" />
                                <PasswordBox x:Name="ConfirmTransferPasswordBox" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Button x:Name="ExportButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Click="ExportButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
