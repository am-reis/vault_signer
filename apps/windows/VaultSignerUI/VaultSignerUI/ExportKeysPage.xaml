<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.ExportKeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="520" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton Content="&#x2190; Back" Padding="0" Click="BackButton_Click" />
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel x:Name="KeySelectionSection" Spacing="8">
                    <TextBlock Text="Keys to include" FontWeight="SemiBold" />
                    <ListView x:Name="KeysList" SelectionMode="Multiple" MaxHeight="180">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:KeyRow">
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind TypeAndPurpose}" Opacity="0.65" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel x:Name="IncludeMasterKeySection" Spacing="4">
                    <CheckBox x:Name="IncludeMasterKeyCheck" Content="Include master key in export" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="Lets the recipient treat this as carrying its own master key instead of just independently-passphrased keys." />
                </StackPanel>

                <TextBlock Text="Protect this export with" FontWeight="SemiBold" />

                <StackPanel Spacing="10">
                    <RadioButton x:Name="AsIsRadio" GroupName="Encryption" Checked="EncryptionOption_Checked" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock Text="Just package the keys as-is" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                                       Text="Keys stay encrypted with their own passphrases; no extra layer is added. The label, description, and resource for each key travel in the clear inside this file. Only use this if the recipient already knows each key's passphrase and the transport channel itself is trusted." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DestinationPasswordRadio" GroupName="Encryption" Checked="EncryptionOption_Checked" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock Text="Re-encrypt for the destination vault's master password" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                                       Text="Choose this only if you know the master password of the vault you're importing into." />
                            <PasswordBox x:Name="DestinationPasswordBox" PlaceholderText="Destination vault's master passphrase" Visibility="Collapsed" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TransferPasswordRadio" GroupName="Encryption" Checked="EncryptionOption_Checked" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock Text="Protect with a one-time transfer password" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                                       Text="Set a new passphrase for this export only. Deliver it to the recipient through a separate channel from the file itself." />
                            <StackPanel x:Name="TransferPasswordFields" Visibility="Collapsed" Spacing="6">
                                <PasswordBox x:Name="TransferPasswordBox" PlaceholderText="Transfer passphrase" />
                                <PasswordBox x:Name="ConfirmTransferPasswordBox" PlaceholderText="Confirm transfer passphrase" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Button x:Name="ExportButton" Content="Export…" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Click="ExportButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
