<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.KeyDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="480" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton Content="&#x2190; Back" Padding="0" Click="BackButton_Click" />
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel Spacing="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Description" FontWeight="SemiBold" Width="110" />
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Resource" FontWeight="SemiBold" Width="110" />
                        <TextBlock x:Name="ResourceText" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Type / Purpose" FontWeight="SemiBold" Width="110" />
                        <TextBlock x:Name="TypeText" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Created" FontWeight="SemiBold" Width="110" />
                        <TextBlock x:Name="CreatedText" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" x:Name="LastUsedRow">
                        <TextBlock Text="Last used" FontWeight="SemiBold" Width="110" />
                        <TextBlock x:Name="LastUsedText" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Public key" FontWeight="SemiBold" />
                        <TextBlock x:Name="PublicKeyText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Opacity="0.85" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Padding="16" CornerRadius="6">
                    <TextBlock Text="Danger zone" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Discarding a key permanently deletes its private material. This cannot be undone." />
                    <TextBlock x:Name="ConfirmPrompt" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="DiscardConfirmBox" />
                        <Button Grid.Column="1" x:Name="DiscardKeyButton" Content="Discard Key" Margin="8,0,0,0" Click="DiscardKeyButton_Click" />
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
