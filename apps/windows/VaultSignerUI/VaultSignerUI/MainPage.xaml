<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">

            <TextBlock Text="VaultSigner" FontSize="24" FontWeight="Bold" />

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="Firebrick" Visibility="Collapsed" />

            <!-- No vault open yet: create or open one -->
            <StackPanel x:Name="NoVaultPanel" Spacing="8">
                <TextBlock Text="Vault path" />
                <TextBox x:Name="VaultPathBox" PlaceholderText="C:\Users\you\VaultSigner\vault.vsvault" />

                <TextBlock Text="Compartment label (for creating a new vault)" />
                <TextBox x:Name="CompartmentLabelBox" PlaceholderText="Personal" />

                <TextBlock Text="Master passphrase" />
                <PasswordBox x:Name="MasterPassphraseBox" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CreateVaultButton" Content="Create Vault" Click="CreateVaultButton_Click" />
                    <Button x:Name="OpenVaultButton" Content="Open Vault" Click="OpenVaultButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Vault is open: compartments, keys, create/detail -->
            <StackPanel x:Name="VaultOpenPanel" Spacing="16" Visibility="Collapsed">

                <StackPanel Spacing="8">
                    <TextBlock Text="Compartment" FontWeight="SemiBold" />
                    <ComboBox x:Name="CompartmentCombo" HorizontalAlignment="Stretch"
                              DisplayMemberPath="label" SelectionChanged="CompartmentCombo_SelectionChanged" />

                    <StackPanel x:Name="UnlockPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <PasswordBox x:Name="UnlockPassphraseBox" PlaceholderText="Passphrase to unlock" Width="240" />
                        <Button x:Name="UnlockButton" Content="Unlock" Click="UnlockButton_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Keys" FontWeight="SemiBold" />
                    <ListView x:Name="KeysList" MaxHeight="240"
                              SelectionChanged="KeysList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:KeyRow">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind TypeAndPurpose}" Foreground="Gray" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Selected key detail -->
                <StackPanel x:Name="KeyDetailPanel" Spacing="4" Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12" CornerRadius="4">
                    <TextBlock x:Name="DetailLabel" FontWeight="Bold" />
                    <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailResource" />
                    <TextBlock x:Name="DetailCreatedAt" />
                    <TextBlock x:Name="DetailPublicKeyHex" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <TextBox x:Name="DiscardConfirmBox" PlaceholderText="Type the key's label to confirm" Width="220" />
                        <Button x:Name="DiscardKeyButton" Content="Discard Key" Click="DiscardKeyButton_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Create key -->
                <StackPanel Spacing="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="12" CornerRadius="4">
                    <TextBlock Text="Create a key" FontWeight="SemiBold" />
                    <TextBox x:Name="NewKeyLabelBox" PlaceholderText="Label" />
                    <TextBox x:Name="NewKeyDescriptionBox" PlaceholderText="Description" />
                    <TextBox x:Name="NewKeyResourceBox" PlaceholderText="Resource (e.g. a hostname or service name)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="NewKeyTypeCombo" Width="140" SelectedIndex="0">
                            <ComboBoxItem Content="Ed25519" />
                            <ComboBoxItem Content="ECDSA P-256" />
                        </ComboBox>
                        <ComboBox x:Name="NewKeyPurposeCombo" Width="160" SelectedIndex="1">
                            <ComboBoxItem Content="FIDO2" />
                            <ComboBoxItem Content="Custom signing" />
                            <ComboBoxItem Content="Both" />
                        </ComboBox>
                    </StackPanel>
                    <PasswordBox x:Name="NewKeyPassphraseBox" PlaceholderText="Key passphrase" />
                    <Button x:Name="CreateKeyButton" Content="Create Key" Click="CreateKeyButton_Click" />
                </StackPanel>

                <Button x:Name="LockAllButton" Content="Lock All" Click="LockAllButton_Click" HorizontalAlignment="Left" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
