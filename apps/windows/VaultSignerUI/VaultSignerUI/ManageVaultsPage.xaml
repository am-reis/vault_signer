<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.ManageVaultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="520" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <HyperlinkButton Content="&#x2190; Back" Padding="0" Click="BackButton_Click" />
                    <TextBlock Text="Known Vaults" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Vaults VaultSigner remembers the location of. Forgetting one only removes it from this list — the file itself is untouched."
                               Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Name="NoVaultsText" Text="No known vaults yet." Opacity="0.7" Visibility="Collapsed" />

                <ListView x:Name="VaultsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:KnownVaultRow">
                            <Grid Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" Foreground="{x:Bind ForegroundBrush}" />
                                    <TextBlock Text="{x:Bind Path}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE7BA;" FontSize="14" Foreground="#F2A93B" Margin="8,0"
                                          Visibility="{x:Bind UnavailableVisibility}" ToolTipService.ToolTip="This file couldn't be found" />
                                <Button Grid.Column="2" Content="Forget" Click="ForgetButton_Click" Tag="{x:Bind Path}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="AddButton" Content="Add a Known Vault…" Click="AddButton_Click" HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
