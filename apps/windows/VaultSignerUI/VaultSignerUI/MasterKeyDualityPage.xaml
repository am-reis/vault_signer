<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.MasterKeyDualityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="DecisionScroll">
            <StackPanel Padding="32,24,32,32" Spacing="18" MaxWidth="560" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="22" />
                    <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Opacity="0.8" />

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <!-- Option 1 -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="Option1TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="RecommendedBadgeText" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="Option1DescriptionText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                        <TextBlock x:Name="Option1NoCompartmentText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" Visibility="Collapsed" />
                        <StackPanel x:Name="Option1Form" Spacing="8">
                            <ComboBox x:Name="Option1CompartmentCombo" DisplayMemberPath="label" HorizontalAlignment="Stretch" />
                            <Button x:Name="Option1Button" Style="{StaticResource AccentButtonStyle}" Click="Option1Button_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Option 2 -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Option2TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="Option2DescriptionText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                        <TextBox x:Name="Option2LabelBox" Text="Imported vault" />
                        <PasswordBox x:Name="Option2PassphraseBox" />
                        <Button x:Name="Option2Button" Style="{StaticResource AccentButtonStyle}" Click="Option2Button_Click" />
                    </StackPanel>
                </Border>

                <!-- Option 3 -->
                <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Option3TitleText" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="Option3DescriptionText" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
                        <TextBlock x:Name="Option3NoCompartmentText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" Visibility="Collapsed" />
                        <StackPanel x:Name="Option3Form" Spacing="8">
                            <ComboBox x:Name="Option3CompartmentCombo" DisplayMemberPath="label" HorizontalAlignment="Stretch" />
                            <PasswordBox x:Name="Option3PassphraseBox" PasswordChanged="Option3PassphraseBox_PasswordChanged" />
                            <TextBox x:Name="Option3ConfirmBox" TextChanged="Option3ConfirmBox_TextChanged" />
                            <Button x:Name="Option3Button" IsEnabled="False"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="Option3Button_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="CancelButtonElement" HorizontalAlignment="Left" Click="CancelButton_Click" />

            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="DoneStep" Spacing="12" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="440">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="24" />
                <TextBlock x:Name="CompleteTitleText" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="DoneWarningsText" Opacity="0.75" TextWrapping="Wrap" Visibility="Collapsed" />
            <Button x:Name="DoneButtonElement" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="DoneButton_Click" />
        </StackPanel>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
