<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.VaultHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="640" HorizontalAlignment="Stretch">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="VaultSigner" FontSize="32" FontWeight="SemiBold" />
                        <HyperlinkButton x:Name="SwitchVaultLink" Content="Open a different vault" Padding="0" Click="SwitchVaultLink_Click" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="SettingsButton" Click="SettingsButton_Click" VerticalAlignment="Top" Margin="0,0,8,0"
                            ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" x:Name="LockAllButton" Click="LockAllButton_Click" VerticalAlignment="Top"
                            ToolTipService.ToolTip="Lock every compartment and wipe cached key material">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="14" />
                            <TextBlock Text="Lock All" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Compartment" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1" Content="New Compartment…" Padding="0" Click="NewCompartmentLink_Click" />
                    </Grid>
                    <ComboBox x:Name="CompartmentCombo" HorizontalAlignment="Stretch"
                              DisplayMemberPath="label" SelectionChanged="CompartmentCombo_SelectionChanged" />

                    <Grid x:Name="UnlockPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox Grid.Column="0" x:Name="UnlockPassphraseBox" PlaceholderText="Passphrase to unlock this compartment" />
                        <Button Grid.Column="1" x:Name="UnlockButton" Content="Unlock" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" Click="UnlockButton_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="KeysSection" Spacing="8" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Keys" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="NewKeyButton" Style="{StaticResource AccentButtonStyle}" Click="NewKeyButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New Key" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="EmptyKeysText" Opacity="0.7" TextWrapping="Wrap"
                               Text="No keys in this compartment yet — click New Key to create one." Visibility="Collapsed" />

                    <ListView x:Name="KeysList" SelectionMode="None" ItemClick="KeysList_ItemClick" IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:KeyRow">
                                <Grid Padding="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind TypeAndPurpose}" Opacity="0.65" FontSize="12" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel x:Name="VaultActionsSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Import &amp; backup" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Import…" Click="ImportButton_Click" />
                        <Button Content="Export Keys…" Click="ExportKeysButton_Click" />
                        <Button Content="Back Up Everything…" Click="BackUpEverythingButton_Click" />
                        <Button Content="Back Up Master Key Only…" Click="BackUpMasterKeyOnlyButton_Click" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
