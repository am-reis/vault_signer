<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="480" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <TextBlock Text="VaultSigner" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Open a vault you've used before, or create a new one." Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recent vaults" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1" Content="Manage known vaults" Padding="0" Click="ManageVaultsLink_Click" />
                    </Grid>

                    <TextBlock x:Name="NoRecentVaultsText" Text="No recent vaults yet." Opacity="0.7" Visibility="Collapsed" />

                    <ListView x:Name="RecentVaultsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentVaultsList_ItemClick" MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:KnownVaultRow">
                                <Grid Padding="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold"
                                                    Foreground="{x:Bind ForegroundBrush}" />
                                        <TextBlock Text="{x:Bind Path}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE7BA;" FontSize="14" Foreground="#F2A93B" Margin="8,0"
                                              Visibility="{x:Bind UnavailableVisibility}" ToolTipService.ToolTip="This file couldn't be found" />
                                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6"
                                            Click="ForgetButton_Click" Tag="{x:Bind Path}" ToolTipService.ToolTip="Forget this vault">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel x:Name="CreateSection" Spacing="8">
                    <TextBlock Text="Create a new vault" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CreateFolderText" Text="No folder chosen" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="Choose Folder…" Margin="8,0,0,0" Click="ChooseFolderButton_Click" />
                    </Grid>
                    <TextBox x:Name="NewVaultFileNameBox" PlaceholderText="File name, e.g. MyVault.vlt" Text="MyVault.vlt" />
                    <TextBox x:Name="CompartmentLabelBox" PlaceholderText="First compartment name, e.g. Personal" Text="Personal" />
                    <PasswordBox x:Name="MasterPassphraseBox" PlaceholderText="Master passphrase" />
                    <PasswordBox x:Name="ConfirmPassphraseBox" PlaceholderText="Confirm master passphrase" />
                    <local:DeviceProfilePicker x:Name="ProfilePicker" />
                    <Button x:Name="CreateVaultButton" Content="Create Vault" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right" Click="CreateVaultButton_Click" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Or open an existing vault file" FontWeight="SemiBold" />
                    <Button x:Name="OpenVaultButton" Content="Browse for a Vault File…" Click="OpenVaultButton_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
