<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaultSignerUI.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaultSignerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="480" HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <TextBlock Text="VaultSigner" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Create a new vault, or open one you already have." Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Vault file" FontWeight="SemiBold" />
                    <TextBox x:Name="VaultPathBox" PlaceholderText="C:\Users\you\VaultSigner\vault.vsvault" />
                </StackPanel>

                <StackPanel x:Name="CreateOnlyFields" Spacing="8">
                    <TextBlock Text="First compartment name" FontWeight="SemiBold" />
                    <TextBox x:Name="CompartmentLabelBox" PlaceholderText="Personal" />
                    <TextBlock Text="Master passphrase" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <PasswordBox x:Name="MasterPassphraseBox" PlaceholderText="Used only when creating a new vault" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button x:Name="OpenVaultButton" Content="Open Existing Vault" Click="OpenVaultButton_Click" />
                    <Button x:Name="CreateVaultButton" Content="Create New Vault" Style="{StaticResource AccentButtonStyle}" Click="CreateVaultButton_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
